# Adapted from Arch's niri package; keep upstream resource names and paths.
pkgname=niri-max-git
pkgver=26.04.r1791925639.gb111a314
pkgrel=1
pkgdesc='Niri with automatic sole-tiled-window fill'
arch=('x86_64')
url='https://github.com/mraxime/niri-fork'
license=('GPL-3.0-or-later')
depends=(
    'cairo' 'glib2' 'glibc' 'libdisplay-info' 'libgcc' 'libinput'
    'libpipewire' 'libxkbcommon' 'mesa' 'pango' 'pixman' 'seatd'
    'systemd-libs' 'xdg-desktop-portal-impl'
)
makedepends=('clang' 'git' 'rust')
optdepends=(
    'alacritty: a suggested GPU-accelerated terminal emulator'
    'bash: for niri-session script'
    'fuzzel: a suggested Wayland application launcher'
    'mako: a suggested Wayland notification daemon'
    'org.freedesktop.secrets: for apps to rely on secrets portal'
    'swaybg: a suggested Wayland wallpaper tool'
    'swaylock: a suggested Wayland screen locker'
    'waybar: a suggested Wayland customizable desktop bar'
    'xwayland-satellite: for running X11 apps in XWayland'
    'xdg-desktop-portal-gtk: a suggested XDG desktop portal'
    'xdg-desktop-portal-gnome: a XDG desktop portal required for screencasting'
)
provides=("niri=${pkgver%%.r*}" 'wayland-compositor')
conflicts=('niri')
source=('niri::git+https://github.com/mraxime/niri-fork.git#branch=fork')
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/niri" || return
    local version major minor patch timestamp revision
    version=$(awk -F '"' '
        /^\[workspace.package\]$/ { workspace = 1; next }
        /^\[/ { workspace = 0 }
        workspace && /^version = / { print $2; exit }
    ' Cargo.toml) || return
    [[ -n $version ]] || return 1
    version=${version%%[-+]*}
    IFS=. read -r major minor patch <<< "$version"
    # Match niri's native year.month[.patch] version without requiring tags.
    version=$(printf '%s.%02d' "$major" "$minor") || return
    if [[ $patch != 0 ]]; then
        version+=".$patch"
    fi
    timestamp=$(git show -s --format=%ct HEAD) || return
    revision=$(git rev-parse --short HEAD) || return
    # Commit time, unlike revision count, increases when the stack is rebased.
    printf '%s.r%s.g%s\n' "$version" "$timestamp" "$revision"
}

prepare() {
    cd "$srcdir/niri" || return
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd "$srcdir/niri" || return
    NIRI_BUILD_COMMIT=$(git rev-parse --short=7 HEAD) || return
    export NIRI_BUILD_COMMIT
    CFLAGS+=' -ffat-lto-objects'
    cargo build --frozen --release --features default
    local shell
    for shell in bash fish zsh; do
        cargo run --frozen --release --bin niri -- \
            completions "$shell" > "$shell-completions"
    done
}

check() (
    cd "$srcdir/niri" || exit
    XDG_RUNTIME_DIR=$(mktemp -d) || exit
    export XDG_RUNTIME_DIR
    trap 'rm -rf -- "$XDG_RUNTIME_DIR"' EXIT
    export RAYON_NUM_THREADS=1
    cargo test --all --exclude niri-visual-tests --frozen
)

package() {
    cd "$srcdir/niri" || return
    install -Dm755 target/release/niri resources/niri-session -t "$pkgdir/usr/bin/"
    install -Dm644 resources/niri.service resources/niri-shutdown.target \
        -t "$pkgdir/usr/lib/systemd/user/"
    install -Dm644 resources/niri.desktop -t "$pkgdir/usr/share/wayland-sessions/"
    install -Dm644 resources/niri-portals.conf -t "$pkgdir/usr/share/xdg-desktop-portal/"
    install -Dm644 resources/default-config.kdl README.md -t "$pkgdir/usr/share/doc/niri/"
    install -Dm644 bash-completions "$pkgdir/usr/share/bash-completion/completions/niri"
    install -Dm644 fish-completions "$pkgdir/usr/share/fish/vendor_completions.d/niri.fish"
    install -Dm644 zsh-completions "$pkgdir/usr/share/zsh/site-functions/_niri"
}
